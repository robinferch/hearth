    "Hearth checks your podcasts in the background. iOS decides when that happens, so notifications can arrive with a delay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearth prüft deine Podcasts im Hintergrund. Wann das passiert, entscheidet iOS – Mitteilungen können daher verzögert ankommen."
          }
        }
      }
    },

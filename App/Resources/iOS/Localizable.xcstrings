      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung verwendet ein veraltetes Token, das nie abläuft. Aktualisiere deinen Server auf audiobookshelf %@ oder neuer und melde dich erneut an, um sichere, erneuerbare Tokens zu erhalten."
          }
        }
      }
    },

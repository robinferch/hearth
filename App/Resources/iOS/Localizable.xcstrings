          }
        }
      }
    },
    "The server's certificate is not trusted by your device. Only trust it if you recognize this SHA-256 fingerprint:\n\n%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gerät vertraut dem Zertifikat des Servers nicht. Vertraue ihm nur, wenn du diesen SHA-256-Fingerabdruck kennst:\n\n%@"
          }
        }
      }
    },
    "The server's certificate is not trusted.": {

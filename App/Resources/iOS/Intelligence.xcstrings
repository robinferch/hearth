    },
    "Gemma 4 E2B is fast and finds most ads. Gemma 4 E4B is more precise but takes about twice as long and needs an iPhone with 12 GB of memory. Keep Hearth open while a model downloads. The model is only loaded while ads are being found." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemma 4 E2B ist schnell und findet die meiste Werbung. Gemma 4 E4B ist präziser, braucht aber etwa doppelt so lange und ein iPhone mit 12 GB Arbeitsspeicher. Lass Hearth geöffnet, während ein Modell geladen wird. Das Modell belegt nur Arbeitsspeicher, während Werbung gesucht wird."
          }
        }
      }
    },
    "Keeps running when you leave Hearth. Estimates get more accurate with every transcript." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft weiter, wenn du Hearth verlässt. Die Schätzung wird mit jedem Transkript genauer."
          }
        }
      }
    },

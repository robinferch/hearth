  "strings" : {
    "%@ finds sponsor reads and commercials on this device, so Hearth can skip them automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ findet Sponsorenblöcke und Werbespots direkt auf diesem Gerät, damit Hearth sie automatisch überspringen kann."
          }
        }
      }
    },
    "%@ finds sponsor reads and commercials, so Hearth can skip them automatically. Uses your Anthropic API key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ findet Sponsorenblöcke und Werbespots, damit Hearth sie automatisch überspringen kann. Nutzt deinen Anthropic-API-Schlüssel."

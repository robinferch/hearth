    },
    "Claude reads the whole transcript at once and is the most accurate. The transcript (not the audio) is sent to Anthropic and billed to your account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude liest das ganze Transkript auf einmal und ist am genauesten. Das Transkript (nicht das Audio) wird an Anthropic gesendet und über dein Konto abgerechnet."
          }
        }
      }
    },
